{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepServer",
  "mainBinaryName": "DeepServer",
  "version": "1.0.0",
  "identifier": "com.demonad112.deepserver",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepServer",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Demonad112",
    "homepage": "https://github.com/Demonad112/stunning-doodler-Reviewed",
    "icon": ["icons/icon.ico"],
    "license": "Apache-2.0",
    "copyright": "Copyright (c) 2026 Demonad112. Portions Copyright (c) 2026 Open Diff Contributors",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
