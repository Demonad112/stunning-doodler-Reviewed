{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepServer",
  "mainBinaryName": "DeepServer",
  "version": "2.0.0-alpha.0",
  "identifier": "com.demonad112.deepserver2",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepServer",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Demonad112",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "license": "Apache-2.0"
  }
}
