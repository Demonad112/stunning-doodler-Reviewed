{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/gh-status.sh:*)",
      "Bash(scripts/prepush.sh:*)",
      "Bash(corepack pnpm quality)",
      "Bash(corepack pnpm test:unit:*)",
      "Bash(corepack pnpm exec prettier:*)",
      "Bash(corepack pnpm exec eslint:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin claude/:*)",
      "Edit(/.github/workflows/**)",
      "Edit(/docs/HANDOFF.md)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(corepack pnpm exec vitest run *)",
      "Bash(corepack pnpm vitest run *)",
      "Bash(corepack pnpm exec vue-tsc *)",
      "Bash(corepack pnpm typecheck)",
      "Bash(corepack pnpm test)",
      "Bash(corepack pnpm exec stylelint *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push --tags:*)"
    ]
  }
}
