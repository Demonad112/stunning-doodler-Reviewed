{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/gh-status.sh:*)",
      "Bash(scripts/prepush.sh:*)",
      "Bash(corepack pnpm quality)",
      "Bash(corepack pnpm test:unit:*)",
      "Bash(corepack pnpm exec prettier:*)",
      "Bash(corepack pnpm exec eslint:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin claude/:*)",
      "Edit(/.github/workflows/**)",
      "Edit(/docs/HANDOFF.md)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(corepack pnpm exec vitest run *)",
      "Bash(corepack pnpm vitest run *)",
      "Bash(corepack pnpm exec vue-tsc *)",
      "Bash(corepack pnpm typecheck)",
      "Bash(corepack pnpm test)",
      "Bash(corepack pnpm exec stylelint *)",
      "Bash(reg query *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Test-Path *)",
      "mcp__computer-use__screenshot",
      "mcp__computer-use__zoom",
      "mcp__ccd_pr__get_status",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__preview_network",
      "mcp__Claude_Browser__preview_snapshot",
      "mcp__Claude_Browser__find",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_screenshot"
    ],
    "deny": [
      "Read(/src-tauri/target/**)",
      "Read(/node_modules/**)",
      "Read(/native/diskusage/build/**)",
      "Read(/docs/history/opendiff/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push --tags:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prepush-gate.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
