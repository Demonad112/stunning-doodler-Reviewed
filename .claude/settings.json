{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/gh-status.sh:*)",
      "Bash(scripts/prepush.sh:*)",
      "Bash(corepack pnpm quality)",
      "Bash(corepack pnpm test:unit:*)",
      "Bash(corepack pnpm exec prettier:*)",
      "Bash(corepack pnpm exec eslint:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin claude/:*)",
      "Edit(/.github/workflows/**)",
      "Edit(/docs/HANDOFF.md)",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs",
      "mcp__github__pull_request_read",
      "mcp__github__get_release_by_tag"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push --tags:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prepush-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
